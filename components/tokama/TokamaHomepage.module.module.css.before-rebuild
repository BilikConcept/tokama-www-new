:global(html) {
  scroll-behavior: smooth;
  background: #ffffff;
}

:global(body) {
  margin: 0;
  overflow-x: hidden;
  background: #ffffff;
}

.page {
  --ink: #101010;
  --line: rgba(16, 16, 16, 0.17);
  --muted: rgba(16, 16, 16, 0.62);
  overflow: clip;
  color: var(--ink);
  background: #ffffff;
  font-family: var(--font-sans), Arial, sans-serif;
}

.page * {
  box-sizing: border-box;
}

.page a {
  color: inherit;
}

.container {
  width: min(1320px, calc(100% - 64px));
  margin: 0 auto;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 30;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  width: 100%;
  height: 80px;
  padding: 0 32px;
  background: transparent;
  border: 0;
  transition: color 220ms ease;
}

.headerOnHero {
  color: #ffffff;
}

.headerBelowHero {
  color: var(--ink);
}

.logo {
  justify-self: start;
  color: inherit;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-decoration: none;
}

.nav {
  display: flex;
  gap: 28px;
  align-items: center;
}

.nav a,
.language,
.headerBook {
  color: inherit;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-decoration: none;
  text-transform: uppercase;
}

.nav a {
  opacity: 0.72;
  transition: opacity 180ms ease;
}

.nav a:hover {
  opacity: 1;
}

.headerActions {
  justify-self: end;
  display: flex;
  gap: 18px;
  align-items: center;
}

.language {
  border-bottom: 1px solid currentColor;
}

.headerBook {
  padding: 10px 0;
  border-bottom: 1px solid currentColor;
}

.hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100svh;
  padding: 112px 24px 64px;
  overflow: hidden;
  color: #ffffff;
  background: #000000;
  isolation: isolate;
  text-align: center;
}

.heroMedia {
  position: absolute;
  inset: 0;
  z-index: -2;
  min-height: 0;
  overflow: hidden;
  background: #000000;
}

.heroVideo,
.heroImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.heroShade {
  position: absolute;
  inset: 0;
  display: block;
  background: rgba(0, 0, 0, 0.38);
}

.heroContent {
  width: min(920px, 100%);
  padding: 0;
}

.hero .eyebrow {
  margin: 0 0 24px;
  color: rgba(255, 255, 255, 0.82);
}

.hero h1 {
  max-width: 900px;
  margin: 0 auto;
  color: #ffffff;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(48px, 7vw, 104px);
  font-weight: 400;
  letter-spacing: -0.065em;
  line-height: 0.92;
}

.heroText {
  display: block;
  max-width: 650px;
  margin: 28px auto 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: clamp(15px, 1.35vw, 18px);
  letter-spacing: -0.02em;
  line-height: 1.55;
}

.heroLinks {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: center;
  margin-top: 38px;
}

.hero .primaryLink,
.hero .secondaryLink {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.72);
}

.hero .primaryLink {
  background: #ffffff;
  color: #111111;
}

.hero .primaryLink:hover {
  background: transparent;
  color: #ffffff;
}

.heroFacts {

  position: absolute;
  bottom: 40px;
  left: clamp(32px, 8vw, 132px);
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(105px, 1fr));
  width: min(570px, calc(50% - 64px));
  margin: 0;
  border-top: 1px solid var(--line);
}

.heroFacts div {
  padding: 14px 14px 0 0;
}

.heroFacts div + div {
  padding-left: 15px;
  border-left: 1px solid var(--line);
}

.heroFacts dt {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.heroFacts dd {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.12em;
  line-height: 1.35;
  text-transform: uppercase;
}

.overview,
.homes,
.relax,
.reviews,
.events,
.footer {
  background: #ffffff;
}

.overview {
  padding: 132px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.overviewGrid {
  display: grid;
  grid-template-columns: 0.42fr 1.12fr 0.72fr;
  gap: 34px;
  align-items: start;
}

.overviewGrid h2 {
  max-width: 700px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(42px, 5vw, 78px);
  font-weight: 400;
  letter-spacing: -0.065em;
  line-height: 0.95;
}

.overviewRight p,
.eventsTop > p,
.bookingPrompt > div:last-child > p {
  max-width: 420px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.63;
}

.overviewRight ul {
  display: grid;
  gap: 11px;
  margin: 34px 0 0;
  padding: 0;
  list-style: none;
}

.overviewRight li {
  padding-top: 11px;
  border-top: 1px solid var(--line);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.homes,
.reviews,
.events {
  padding: 132px 0;
  scroll-margin-top: 100px;
}

.sectionIntro {
  display: grid;
  grid-template-columns: 0.42fr 1.12fr;
  gap: 34px;
  align-items: start;
  margin-bottom: 68px;
}

.sectionIntro .eyebrowDark {
  margin-top: 8px;
}

.homesGrid,
.eventsGrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(350px, 0.83fr);
  gap: clamp(44px, 8vw, 126px);
  align-items: start;
}

.imageFrameTall,
.imageFrameEvent {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  background: #ffffff;
}

.imageFrameTall {
  min-height: 720px;
}

.imageFrameEvent {
  min-height: 610px;
}

.cover {
  object-fit: cover;
}

.homeDetails {
  padding-top: 4px;
}

.sectionText {
  max-width: 530px;
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  letter-spacing: -0.018em;
  line-height: 1.65;
}

.specList {
  display: grid;
  margin: 43px 0 0;
  border-top: 1px solid var(--line);
}

.specList div {
  display: grid;
  grid-template-columns: 0.36fr 0.64fr;
  gap: 22px;
  padding: 17px 0;
  border-bottom: 1px solid var(--line);
}

.specList dt,
.amenities > p {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.specList dd {
  margin: 0;
  font-size: 14px;
  line-height: 1.4;
}

.amenities {
  margin-top: 38px;
}

.amenities > p {
  margin: 0 0 16px;
}

.amenities ul {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px 18px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.amenities li,
.rules li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.amenities li {
  font-size: 13px;
  line-height: 1.35;
}

.amenities li::before,
.rules li::before {
  width: 4px;
  height: 4px;
  flex: 0 0 auto;
  margin-top: 6px;
  content: "";
  background: var(--ink);
  border-radius: 50%;
}

.rules {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  margin: 36px 0 38px;
  padding: 0;
  color: var(--muted);
  list-style: none;
}

.rules li {
  font-size: 11px;
  line-height: 1.4;
}

.relax {
  padding: 0 0 132px;
  scroll-margin-top: 100px;
}

.relaxMedia {
  position: relative;
  width: min(1320px, calc(100% - 64px));
  height: min(57vw, 690px);
  min-height: 470px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid var(--line);
}

.relaxShade {
  display: none;
}

.relax .container {
  margin-top: 92px;
}

.relaxGrid {
  display: grid;
  grid-template-columns: 0.92fr 0.72fr;
  gap: clamp(52px, 12vw, 190px);
  align-items: end;
}

.relaxText {
  max-width: 520px;
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.65;
}

.relaxFacts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 26px;
  margin: 48px 0 0;
  border-top: 1px solid var(--line);
}

.relaxFacts div {
  padding: 17px 0;
  border-bottom: 1px solid var(--line);
}

.relaxFacts dt {
  font-size: 13px;
  font-weight: 500;
}

.relaxFacts dd {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.13em;
  line-height: 1.4;
  text-transform: uppercase;
}

.reviews {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.reviewHeading {
  display: grid;
  grid-template-columns: 1.1fr 0.6fr;
  gap: clamp(42px, 9vw, 150px);
  align-items: end;
}

.googleLink {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  width: fit-content;
  padding-bottom: 8px;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.13em;
  line-height: 1.45;
  text-decoration: none;
  text-transform: uppercase;
}

.reviewMeta {
  display: grid;
  grid-template-columns: 0.85fr 0.75fr auto;
  gap: 30px;
  align-items: end;
  margin-top: 72px;
  padding: 27px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.reviewMeta p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.13em;
  line-height: 1.45;
  text-transform: uppercase;
}

.reviewMeta div > p {
  margin-bottom: 10px;
}

.reviewMeta strong {
  display: block;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(45px, 5vw, 74px);
  font-weight: 400;
  letter-spacing: -0.07em;
  line-height: 0.85;
}

.reviewMeta a {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  justify-self: end;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--ink);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-decoration: none;
  text-transform: uppercase;
}

.reviewQuotes {
  display: grid;
  margin-top: 15px;
  border-top: 1px solid var(--line);
}

.reviewQuotes blockquote {
  display: grid;
  grid-template-columns: 52px 1fr auto;
  gap: 20px;
  align-items: end;
  margin: 0;
  padding: 27px 0;
  border-bottom: 1px solid var(--line);
}

.reviewQuotes span,
.reviewQuotes cite {
  color: var(--muted);
  font-size: 10px;
  font-style: normal;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.reviewQuotes p {
  max-width: 730px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(28px, 3.3vw, 50px);
  font-weight: 400;
  letter-spacing: -0.055em;
  line-height: 0.98;
}

.events {
  border-bottom: 1px solid var(--line);
}

.eventsTop {
  display: grid;
  grid-template-columns: 1.12fr 0.58fr;
  gap: clamp(44px, 8vw, 132px);
  align-items: end;
  margin-bottom: 67px;
}

.eventsGrid {
  align-items: stretch;
}

.eventFeatures {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--line);
}

.eventFeatures li {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 15px;
  align-items: center;
  min-height: 82px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  font-size: 15px;
  line-height: 1.35;
}

.eventFeatures span {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.11em;
}

.bookingPrompt {
  display: grid;
  grid-template-columns: 1.04fr 0.66fr;
  gap: clamp(42px, 9vw, 145px);
  align-items: end;
  margin-top: 105px;
  padding: 31px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.bookingPrompt h3 {
  max-width: 670px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(36px, 4.1vw, 64px);
  font-weight: 400;
  letter-spacing: -0.06em;
  line-height: 0.95;
}

.bookingPromptLink {
  width: fit-content;
  margin-top: 29px;
}

.footer {
  padding: 64px 0 34px;
}

.footerGrid {
  display: grid;
  grid-template-columns: 1.1fr 0.72fr auto;
  gap: 46px;
  align-items: end;
}

.footerLogo {
  margin: 0;
  font-size: 19px;
  font-weight: 500;
  letter-spacing: 0.23em;
}

.footerGrid > div:first-child > p:last-child {
  max-width: 250px;
  margin: 18px 0 0;
  color: var(--muted);
  font-family: var(--font-serif), Georgia, serif;
  font-size: 20px;
  font-style: italic;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.footerGrid > div:nth-child(2) {
  display: grid;
  gap: 8px;
}

.footerGrid > div:nth-child(2) > p {
  margin: 0 0 7px;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.footerGrid > div:nth-child(2) a,
.footerGrid > div:nth-child(2) span {
  color: var(--ink);
  font-size: 13px;
  text-decoration: none;
}

@media (max-width: 980px) {
  .container,
  .relaxMedia {
    width: min(100% - 40px, 760px);
  }

  .header {
    height: 72px;
    grid-template-columns: 1fr auto;
    padding: 0 20px;
  }

  .nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 72px;
  }

  .heroMedia {
    grid-column: 1;
    grid-row: 1;
    min-height: 62svh;
  }

  .heroContent {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    padding: 68px 20px 48px;
  }

  .heroFacts {
    position: static;
    grid-column: 1;
    grid-row: 3;
    width: calc(100% - 40px);
    margin: 0 20px 54px;
  }

  .overview,
  .homes,
  .reviews,
  .events {
    padding: 92px 0;
  }

  .overviewGrid,
  .sectionIntro,
  .homesGrid,
  .relaxGrid,
  .reviewHeading,
  .eventsTop,
  .eventsGrid,
  .bookingPrompt {
    grid-template-columns: 1fr;
  }

  .overviewGrid,
  .sectionIntro,
  .eventsTop,
  .reviewHeading {
    gap: 24px;
  }

  .sectionIntro {
    margin-bottom: 44px;
  }

  .imageFrameTall {
    min-height: 560px;
  }

  .imageFrameEvent {
    min-height: 510px;
  }

  .homesGrid,
  .eventsGrid,
  .relaxGrid {
    gap: 42px;
  }

  .relax {
    padding-bottom: 92px;
  }

  .relax .container {
    margin-top: 65px;
  }

  .bookingPrompt {
    gap: 30px;
    margin-top: 74px;
  }

  .footerGrid {
    grid-template-columns: 1fr 1fr;
  }

  .footerBook {
    grid-column: 1 / -1;
    width: fit-content;
    margin-top: 14px;
  }
}

@media (max-width: 640px) {
  .headerActions {
    gap: 13px;
  }

  .logo {
    font-size: 16px;
  }

  .headerBook {
    font-size: 9px;
  }

  .heroMedia {
    min-height: 54svh;
  }

  .hero h1,
  .sectionIntro h2,
  .relax h2,
  .reviewHeading h2,
  .eventsTop h2 {
    font-size: clamp(47px, 14vw, 72px);
  }

  .heroText,
  .sectionText,
  .relaxText {
    font-size: 15px;
  }

  .heroFacts {
    grid-template-columns: 1fr 1fr;
  }

  .heroFacts div:nth-child(3) {
    grid-column: 1 / -1;
    margin-top: 13px;
    padding-left: 0;
    border-left: 0;
  }

  .overviewGrid h2 {
    font-size: clamp(40px, 12vw, 58px);
  }

  .specList div {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .amenities ul,
  .relaxFacts {
    grid-template-columns: 1fr;
  }

  .imageFrameTall {
    min-height: 440px;
  }

  .imageFrameEvent {
    min-height: 390px;
  }

  .reviewMeta {
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 50px;
  }

  .reviewMeta a {
    justify-self: start;
  }

  .reviewQuotes blockquote {
    grid-template-columns: 32px 1fr;
    gap: 14px;
  }

  .reviewQuotes cite {
    grid-column: 2;
  }

  .eventsTop {
    margin-bottom: 42px;
  }

  .footer {
    padding-top: 56px;
  }

  .footerGrid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .footerBook {
    grid-column: auto;
    margin-top: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  :global(html) {
    scroll-behavior: auto;
  }

  .arrow {
    transition: none;
  }
}


/* TOKAMA_FULLSCREEN_VIDEO_HERO */
.header {
  height: 84px;
  color: #ffffff;
  border: 0;
  background: transparent;
  backdrop-filter: none;
  mix-blend-mode: difference;
}

.hero {
  position: relative;
  display: flex;
  min-height: 100svh;
  align-items: flex-end;
  padding: 0 clamp(32px, 8vw, 132px) 118px;
  color: #ffffff;
  background: #000000;
  isolation: isolate;
}

.heroMedia {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: block;
  min-height: 0;
  overflow: hidden;
  background: #000000;
}

.heroImage,
.heroVideo,
.heroShade {
  position: absolute;
  inset: 0;
}

.heroImage,
.heroVideo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.heroVideo {
  z-index: 1;
  transform: scale(1.015);
}

.heroShade {
  z-index: 2;
  display: block;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.08) 70%),
    linear-gradient(0deg, rgba(0, 0, 0, 0.54) 0%, rgba(0, 0, 0, 0) 65%);
}

.heroContent {
  position: relative;
  z-index: 3;
  display: block;
  width: min(860px, 100%);
  padding: 0;
}

.hero .eyebrow {
  color: rgba(255, 255, 255, 0.8);
}

.hero h1 {
  color: #ffffff;
  font-size: clamp(62px, 8.3vw, 138px);
  line-height: 0.88;
}

.heroText,
.heroFacts {
  display: none;
}

.heroLinks {
  margin-top: 38px;
}

.hero .primaryLink,
.hero .secondaryLink {
  min-height: 52px;
  color: #ffffff;
  background: transparent;
}

.hero .primaryLink {
  padding: 0 22px;
  border: 1px solid rgba(255, 255, 255, 0.92);
}

.hero .secondaryLink {
  border-bottom: 1px solid rgba(255, 255, 255, 0.82);
}

@media (max-width: 980px) {
  .header {
    height: 72px;
  }

  .hero {
    display: flex;
    min-height: 100svh;
    padding: 0 20px 76px;
  }

  .heroMedia {
    grid-column: auto;
    grid-row: auto;
    min-height: 0;
  }

  .heroContent {
    grid-column: auto;
    grid-row: auto;
    align-self: auto;
    width: 100%;
  }

  .hero h1 {
    font-size: clamp(54px, 14vw, 82px);
  }
}

@media (max-width: 640px) {
  .hero {
    padding-bottom: 58px;
  }

  .heroLinks {
    gap: 14px 20px;
    margin-top: 30px;
  }
}




/* HERO — układ jak referencja, z istniejącym wideo */
.hero {
  align-items: center;
  justify-content: center;
  padding: 120px 24px 72px;
}

.heroShade {
  background: rgba(0, 0, 0, 0.31);
}

.heroContent {
  width: min(980px, 100%);
  transform: translateY(10px);
}

.hero .eyebrow {
  margin: 0 0 28px;
  color: rgba(255, 255, 255, 0.9);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.2em;
}

.hero h1 {
  max-width: 980px;
  margin: 0 auto;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(54px, 6vw, 100px);
  font-weight: 300;
  letter-spacing: -0.075em;
  line-height: 0.94;
}

.hero h1 em {
  font-style: italic;
  font-weight: 300;
}

.heroText {
  display: block !important;
  max-width: 570px;
  margin: 32px auto 0;
  color: rgba(255, 255, 255, 0.92);
  font-size: 16px;
  letter-spacing: -0.02em;
  line-height: 1.55;
}

.heroLinks {
  gap: 16px;
  justify-content: center;
  margin-top: 34px;
}

.hero .primaryLink,
.hero .secondaryLink {
  min-height: 58px;
  padding: 0 28px;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero .primaryLink {
  color: #171717;
  background: #ffffff;
  border: 1px solid #ffffff;
  border-radius: 999px;
}

.hero .secondaryLink {
  color: #ffffff;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 999px;
}

.hero .primaryLink:hover {
  color: #ffffff;
  background: transparent;
}

.headerOnHero,
.headerOnHero a,
.headerOnHero button {
  color: #ffffff !important;
}

.headerBelowHero,
.headerBelowHero a,
.headerBelowHero button {
  color: #111111 !important;
}

@media (max-width: 700px) {
  .hero {
    padding: 105px 24px 54px;
  }

  .heroContent {
    transform: none;
  }

  .hero h1 {
    font-size: clamp(46px, 13vw, 68px);
    line-height: 0.96;
  }

  .heroText {
    max-width: 330px;
    margin-top: 25px;
    font-size: 15px;
  }

  .heroLinks {
    gap: 10px;
    margin-top: 28px;
  }

  .hero .primaryLink,
  .hero .secondaryLink {
    min-height: 52px;
    padding: 0 19px;
  }
}


/* Header i CTA hero — finalna korekta */
.header {
  height: 104px;
  padding: 0 78px;
  background: transparent !important;
  border: 0 !important;
  backdrop-filter: none !important;
}

.headerOnHero,
.headerOnHero .logo,
.headerOnHero .nav a,
.headerOnHero .headerActions,
.headerOnHero .headerActions a {
  color: #ffffff !important;
}

.headerBelowHero,
.headerBelowHero .logo,
.headerBelowHero .nav a,
.headerBelowHero .headerActions,
.headerBelowHero .headerActions a {
  color: #111111 !important;
}

.logo {
  font-size: 20px;
  font-weight: 500;
  letter-spacing: 0.3em;
}

.nav {
  gap: 36px;
}

.nav a {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  opacity: 0.9;
}

.headerActions {
  gap: 28px;
}

.languageSwitch {
  display: inline-flex;
  gap: 9px;
  align-items: center;
  font-size: 11px;
  letter-spacing: 0.14em;
}

.languageSwitch a {
  color: inherit;
  text-decoration: none;
  opacity: 0.72;
}

.activeLanguage {
  padding-bottom: 3px;
  border-bottom: 1px solid currentColor;
}

.headerBook {
  min-height: 50px;
  padding: 0 22px !important;
  border: 1px solid currentColor !important;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  text-decoration: none !important;
}

.hero .primaryLink,
.hero .secondaryLink,
.hero .primaryLink:hover,
.hero .secondaryLink:hover {
  gap: 10px;
  align-items: center;
  justify-content: center;
  text-decoration: none !important;
}

.hero .primaryLink {
  min-width: 198px;
  border-bottom: 1px solid #ffffff !important;
}

.hero .secondaryLink {
  min-width: 198px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.82) !important;
}

@media (max-width: 980px) {
  .header {
    height: 80px;
    padding: 0 24px;
  }

  .nav {
    gap: 18px;
  }
}

@media (max-width: 700px) {
  .header {
    height: 72px;
  }

  .nav {
    display: none;
  }

  .logo {
    font-size: 16px;
  }

  .headerActions {
    gap: 15px;
  }

  .headerBook {
    min-height: 40px;
    padding: 0 14px !important;
  }

  .languageSwitch {
    gap: 6px;
  }

  .hero .primaryLink,
  .hero .secondaryLink {
    min-width: 0;
  }
}


/* Usunięcie starych nadpisań headera i CTA */
.headerOnHero .logo,
.headerOnHero .nav a,
.headerOnHero .languageSwitch,
.headerOnHero .languageSwitch a,
.headerOnHero .headerBook {
  color: #ffffff !important;
  opacity: 1 !important;
}

.headerOnHero .headerBook {
  border-color: #ffffff !important;
}

.hero .primaryLink,
.hero .secondaryLink {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box;
  height: 58px;
  min-height: 58px;
  padding: 0 30px !important;
  border-bottom: 0 !important;
  line-height: 1;
  text-decoration: none !important;
}

.hero .primaryLink {
  min-width: 208px;
  color: #171717 !important;
  background: #ffffff !important;
  border: 1px solid #ffffff !important;
}

.hero .secondaryLink {
  min-width: 208px;
  color: #ffffff !important;
  background: transparent !important;
  border: 1px solid rgba(255, 255, 255, 0.9) !important;
}

@media (max-width: 700px) {
  .hero .primaryLink,
  .hero .secondaryLink {
    min-width: 0;
    height: 52px;
    min-height: 52px;
    padding: 0 20px !important;
  }
}


/* Kolor headera zależny wyłącznie od sekcji */
.headerOnHero,
.headerOnHero * {
  color: #ffffff !important;
}

.headerOnHero .headerBook {
  border-color: #ffffff !important;
}

.headerBelowHero,
.headerBelowHero * {
  color: #111111 !important;
}

.headerBelowHero .headerBook {
  border-color: #111111 !important;
}


/* Header: kolor sterowany bezpośrednio przez React */
.header .logo,
.header .nav a,
.header .headerActions,
.header .headerActions a,
.header .languageSwitch {
  color: inherit !important;
  opacity: 1 !important;
}

.header .headerBook {
  color: inherit !important;
  border-color: currentColor !important;
}

/* Header automatycznie kontrastuje z aktualną sekcją */
.header {
  color: #ffffff !important;
  mix-blend-mode: difference;
}

.header .logo,
.header .nav a,
.header .headerActions,
.header .headerActions a,
.header .languageSwitch,
.header .headerBook {
  color: inherit !important;
  opacity: 1 !important;
}

.header .headerBook {
  border-color: currentColor !important;
}
