:root {
  --background: #ffffff;
  --foreground: #000000;
  --muted: rgba(0, 0, 0, 0.58);
  --line: rgba(0, 0, 0, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: auto;
  background: var(--background);
}

body {
  margin: 0;
  color: var(--foreground);
  background: var(--background);
  font-family: var(--font-sans), Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

::selection {
  color: #ffffff;
  background: #000000;
}

a,
button {
  font-family: inherit;
}

main {
  background: #ffffff;
}

.tokama-section {
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding: clamp(72px, 9vw, 132px) clamp(20px, 7vw, 112px);
  background: #ffffff;
  color: #000000;
  border-bottom: 1px solid var(--line);
}

.tokama-section--black {
  background: #000000;
  color: #ffffff;
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
}

.tokama-section__inner {
  width: 100%;
}

.section-placeholder {
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding: clamp(72px, 9vw, 132px) clamp(20px, 7vw, 112px);
  background: #ffffff;
  color: #000000;
  border-bottom: 1px solid var(--line);
}

.section-kicker {
  margin: 0 0 22px;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.section-placeholder h2 {
  max-width: 980px;
  margin: 0;
  font-family: var(--font-sans), Arial, sans-serif;
  font-size: clamp(56px, 8vw, 128px);
  line-height: 0.92;
  letter-spacing: -0.075em;
  font-weight: 380;
}

.section-placeholder h2 em {
  font-style: italic;
  font-weight: 380;
  letter-spacing: -0.085em;
}

@media (max-width: 700px) {
  .tokama-section,
  .section-placeholder {
    min-height: 100svh;
    padding: 90px 20px 56px;
  }

  .section-placeholder h2 {
    font-size: clamp(44px, 13vw, 72px);
    line-height: 0.94;
  }
}

/* Scroll reveal animations */
[data-reveal] {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}

[data-reveal="image"] {
  transform: translateY(34px) scale(0.985);
  transition:
    opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

[data-reveal].is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal],
  [data-reveal="image"] {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* Reschio-inspired motion system */
[data-reveal] {
  opacity: 0;
  transform: translateY(14px);
  transition:
    opacity 1200ms cubic-bezier(0.16, 1, 0.3, 1),
    transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

[data-reveal].is-visible {
  opacity: 1;
  transform: translateY(0);
}

[data-reveal="image"] {
  opacity: 1;
  overflow: hidden;
  transform: none;
  clip-path: inset(0 0 100% 0);
  transition:
    clip-path 1300ms cubic-bezier(0.76, 0, 0.24, 1);
  will-change: clip-path;
}

[data-reveal="image"].is-visible {
  clip-path: inset(0 0 0 0);
}

[data-reveal="image"] img {
  transform: scale(1.12);
  transition:
    transform 1600ms cubic-bezier(0.16, 1, 0.3, 1),
    filter 900ms ease;
  will-change: transform;
}

[data-reveal="image"].is-visible img {
  transform: scale(1.02);
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal],
  [data-reveal="image"],
  [data-reveal="image"] img {
    opacity: 1;
    transform: none;
    clip-path: none;
    transition: none;
  }
}

/* Stable image reveal fix */
[data-reveal="image"] {
  opacity: 1 !important;
  overflow: hidden;
  clip-path: inset(0 0 100% 0);
}

[data-reveal="image"].is-visible {
  clip-path: inset(0 0 0 0) !important;
}

[data-reveal="image"] img {
  opacity: 1 !important;
  display: block;
}
