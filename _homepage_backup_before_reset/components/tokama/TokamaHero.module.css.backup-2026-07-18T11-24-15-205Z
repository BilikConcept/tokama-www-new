.hero {
  position: relative;
  height: 100svh;
  min-height: 620px;
  overflow: hidden;
  color: #fff;
  background: #0b0b0b;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 60;
  width: 100%;
  height: 84px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 clamp(20px, 4vw, 64px);
  color: #fff;
  transition:
    background-color 500ms ease,
    color 500ms ease,
    height 500ms ease,
    border-color 500ms ease,
    backdrop-filter 500ms ease;
}

.headerScrolled {
  height: 72px;
  color: #111;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(17, 17, 17, 0.08);
}

.headerMenuOpen {
  color: #111;
  background: #ffffff;
}

.logo {
  justify-self: start;
  color: inherit;
  text-decoration: none;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: 0.24em;
}

.nav {
  display: flex;
  align-items: center;
  gap: clamp(18px, 2vw, 30px);
}

.nav a,
.lang a,
.bookButton,
.menuButton {
  color: inherit;
  text-decoration: none;
  font-size: 11px;
  line-height: 1;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.nav a {
  position: relative;
  opacity: 0.9;
}

.nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -7px;
  width: 0;
  height: 1px;
  background: currentColor;
  transition: width 300ms ease;
}

.nav a:hover::after {
  width: 100%;
}

.actions {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 22px;
}

.lang {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.activeLang {
  border-bottom: 1px solid currentColor;
}

.bookButton {
  padding: 13px 19px;
  border: 1px solid currentColor;
  border-radius: 999px;
  transition:
    background-color 300ms ease,
    color 300ms ease;
}

.bookButton:hover {
  color: #111;
  background: #fff;
}

.headerScrolled .bookButton:hover,
.headerMenuOpen .bookButton:hover {
  color: #fff;
  background: #111;
}

.menuButton {
  display: none;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.mobileMenu {
  display: none;
}

.media {
  position: absolute;
  inset: 0;
}

.video,
.fallbackImage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.video {
  object-fit: cover;
  transform: scale(1.03);
}

.fallbackImage {
  z-index: -1;
  background:
    radial-gradient(circle at 24% 20%, rgba(255, 255, 255, 0.18), transparent 28%),
    linear-gradient(135deg, #1f251f 0%, #101511 48%, #050505 100%);
}

.overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(0, 0, 0, 0.68), rgba(0, 0, 0, 0.18) 54%, rgba(0, 0, 0, 0.34)),
    linear-gradient(to right, rgba(0, 0, 0, 0.34), transparent 58%);
}

.content {
  position: absolute;
  left: clamp(20px, 7vw, 112px);
  bottom: clamp(72px, 9vh, 112px);
  z-index: 2;
  width: min(780px, calc(100% - 40px));
  animation: contentIn 1100ms ease both;
}

.eyebrow {
  margin: 0 0 20px;
  font-size: 11px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  opacity: 0.86;
}

.content h1 {
  max-width: 780px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(52px, 7.5vw, 118px);
  line-height: 0.94;
  letter-spacing: -0.058em;
  font-weight: 400;
}

.description {
  max-width: 560px;
  margin: 28px 0 0;
  font-size: clamp(16px, 1.2vw, 19px);
  line-height: 1.68;
  letter-spacing: -0.018em;
  opacity: 0.91;
}

.ctaRow {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 38px;
}

.primaryCta,
.secondaryCta {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 0 24px;
  color: #fff;
  border-radius: 999px;
  text-decoration: none;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  transition:
    transform 300ms ease,
    background-color 300ms ease,
    color 300ms ease,
    border-color 300ms ease;
}

.primaryCta {
  color: #111;
  background: #fff;
}

.secondaryCta {
  border: 1px solid rgba(255, 255, 255, 0.72);
}

.primaryCta:hover,
.secondaryCta:hover {
  transform: translateY(-2px);
}

.secondaryCta:hover {
  color: #111;
  background: #fff;
  border-color: #fff;
}

.scrollHint {
  position: absolute;
  right: clamp(20px, 4vw, 64px);
  bottom: 42px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  opacity: 0.76;
}

.scrollHint span {
  display: block;
  width: 42px;
  height: 1px;
  background: currentColor;
}

@keyframes contentIn {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 980px) {
  .header {
    height: 74px;
    grid-template-columns: 1fr auto;
  }

  .nav {
    display: none;
  }

  .actions {
    gap: 15px;
  }

  .bookButton {
    display: none;
  }

  .menuButton {
    display: inline-flex;
  }

  .mobileMenu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 110px 20px 34px;
    color: #111;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 420ms ease,
      transform 420ms ease;
  }

  .mobileMenuOpen {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobileMenu nav {
    display: grid;
    gap: 18px;
  }

  .mobileMenu nav a {
    color: inherit;
    text-decoration: none;
    font-family: var(--font-serif), Georgia, serif;
    font-size: clamp(42px, 12vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .mobileBook {
    display: inline-flex;
    width: fit-content;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 0 22px;
    color: #fff;
    background: #111;
    border-radius: 999px;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .content {
    left: 20px;
    bottom: 54px;
    width: calc(100% - 40px);
  }

  .content h1 {
    font-size: clamp(44px, 13vw, 72px);
    line-height: 0.97;
  }

  .description {
    max-width: 94%;
    margin-top: 22px;
    font-size: 15px;
  }

  .ctaRow {
    flex-direction: column;
    align-items: flex-start;
    margin-top: 30px;
  }

  .primaryCta,
  .secondaryCta {
    min-height: 46px;
  }

  .scrollHint {
    display: none;
  }
}

@media (max-width: 520px) {
  .lang {
    gap: 5px;
  }

  .content {
    bottom: 46px;
  }

  .eyebrow {
    margin-bottom: 16px;
  }

  .content h1 {
    max-width: 360px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .header,
  .bookButton,
  .video,
  .content,
  .mobileMenu,
  .primaryCta,
  .secondaryCta {
    transition: none;
    animation: none;
    transform: none;
  }
}

.bookingBar {
  position: absolute;
  left: clamp(20px, 4vw, 64px);
  right: clamp(20px, 4vw, 64px);
  bottom: 24px;
  z-index: 8;
  display: grid;
  grid-template-columns: 1fr 1fr 0.72fr 0.72fr 1.1fr;
  align-items: stretch;
  min-height: 82px;
  padding: 10px;
  color: #000000;
  background: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 999px;
  box-shadow: 0 26px 80px rgba(0, 0, 0, 0.22);
}

.bookingField {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  padding: 0 22px;
  border-right: 1px solid rgba(0, 0, 0, 0.12);
}

.bookingField label {
  margin-bottom: 8px;
  color: rgba(0, 0, 0, 0.52);
  font-size: 10px;
  line-height: 1;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.bookingField input {
  width: 100%;
  min-width: 0;
  padding: 0;
  color: #000000;
  background: transparent;
  border: 0;
  outline: 0;
  font-size: 15px;
  letter-spacing: -0.02em;
  font-family: var(--font-sans), Arial, sans-serif;
}

.bookingField input[type="number"] {
  appearance: textfield;
}

.bookingField input[type="number"]::-webkit-outer-spin-button,
.bookingField input[type="number"]::-webkit-inner-spin-button {
  margin: 0;
  appearance: none;
}

.bookingSubmitWrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-left: 22px;
}

.bookingSubmitWrap p {
  max-width: 132px;
  margin: 0;
  color: rgba(0, 0, 0, 0.52);
  font-size: 10px;
  line-height: 1.35;
  letter-spacing: 0.04em;
}

.bookingSubmit {
  display: inline-flex;
  min-height: 62px;
  align-items: center;
  justify-content: center;
  padding: 0 28px;
  color: #ffffff;
  background: #000000;
  border: 1px solid #000000;
  border-radius: 999px;
  cursor: pointer;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition:
    background-color 300ms ease,
    color 300ms ease,
    transform 300ms ease;
}

.bookingSubmit:hover {
  color: #000000;
  background: #ffffff;
  transform: translateY(-1px);
}

@media (min-width: 981px) {
  .content {
    bottom: clamp(148px, 18vh, 190px);
  }
}

@media (max-width: 980px) {
  .bookingBar {
    left: 20px;
    right: 20px;
    bottom: 18px;
    grid-template-columns: 1fr 1fr;
    min-height: auto;
    padding: 10px;
    border-radius: 28px;
  }

  .bookingField {
    min-height: 62px;
    padding: 0 14px;
  }

  .bookingField:nth-child(2) {
    border-right: 0;
  }

  .bookingField:nth-child(3),
  .bookingField:nth-child(4) {
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .bookingSubmitWrap {
    grid-column: 1 / -1;
    min-height: 58px;
    padding: 10px 0 0;
  }

  .bookingSubmitWrap p {
    padding-left: 14px;
  }

  .bookingSubmit {
    min-height: 50px;
    padding: 0 22px;
  }

  .content {
    bottom: 238px;
  }
}

@media (max-width: 520px) {
  .bookingBar {
    bottom: 14px;
  }

  .bookingField {
    min-height: 56px;
  }

  .bookingSubmitWrap p {
    max-width: 150px;
  }

  .content {
    bottom: 228px;
  }

  .description {
    display: none;
  }

  .ctaRow {
    display: none;
  }
}

