              </p>

              <Link href={bookingHref} className={styles.bookingPromptLink}>
                {locale === "pl" ? "Przejdź do rezerwacji" : "Go to booking"} <Arrow />
              </Link>
            </div>
          </div>
        </div>
      </section>

      <footer id="kontakt" className={styles.footer}>
        <div className={styles.container}>
          <div className={styles.footerGrid}>
            <div>
              <p className={styles.footerLogo}>TOKAMA</p>
              <p>{t.footer.note}</p>
            </div>

            <div>
              <p>{t.footer.contact}</p>
              <a href="tel:+48604811474">{t.footer.phone}</a>
              <a href="mailto:kontakt@tokama.pl">{t.footer.email}</a>
              <span>{t.footer.address}</span>
            </div>

            <Link href={bookingHref} className={styles.footerBook}>
              {t.footer.booking} <Arrow />
            </Link>
          </div>
        </div>
      </footer>
    </main>
