          <video
            className={styles.heroVideo}
            autoPlay
            muted
            loop
            playsInline
            poster="/images/tokama-hero-poster.jpg"
          >
            <source src="/desktop/main-hero.mp4" type="video/mp4" />
          </video>
          <div className={styles.heroShade} />
        </div>

        <div className={styles.heroContent}>
          <p className={styles.eyebrow}>{t.hero.eyebrow}</p>
          <h1>
            {t.hero.lead} <em>{t.hero.emphasis}</em>
            <br />
            {t.hero.end}
          </h1>
          <div className={styles.heroLinks}>
            <Link href={bookingHref} className={styles.primaryLink}>
              {t.hero.primary} <Arrow />
            </Link>
            <a href="#domki" className={styles.secondaryLink}>
              {t.hero.secondary} <Arrow />
            </a>
          </div>
        </div>

      </section>

      <section className={styles.overview}>
        <div className={styles.container}>
          <div className={styles.overviewGrid}>
            <p className={styles.eyebrowDark}>{t.overview.label}</p>
            <h2>{t.overview.title}</h2>
            <div className={styles.overviewRight}>
              <p>{t.overview.text}</p>
              <ul>
