:global(html) {
  scroll-behavior: smooth;
  background: #ffffff;
}

:global(body) {
  margin: 0;
  overflow-x: hidden;
  background: #ffffff;
}

.page {
  --ink: #101010;
  --line: rgba(16, 16, 16, 0.17);
  --muted: rgba(16, 16, 16, 0.62);
  overflow: clip;
  color: var(--ink);
  background: #ffffff;
  font-family: var(--font-sans), Arial, sans-serif;
}

.page * {
  box-sizing: border-box;
}

.page a {
  color: inherit;
}

.container {
  width: min(1320px, calc(100% - 64px));
  margin: 0 auto;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 30;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  width: 100%;
  height: 80px;
  padding: 0 32px;
  color: var(--ink);
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(14px);
}

.logo {
  justify-self: start;
  color: inherit;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-decoration: none;
}

.nav {
  display: flex;
  gap: 28px;
  align-items: center;
}

.nav a,
.language,
.headerBook {
  color: inherit;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-decoration: none;
  text-transform: uppercase;
}

.nav a {
  opacity: 0.72;
  transition: opacity 180ms ease;
}

.nav a:hover {
  opacity: 1;
}

.headerActions {
  justify-self: end;
  display: flex;
  gap: 18px;
  align-items: center;
}

.language {
  border-bottom: 1px solid currentColor;
}

.headerBook {
  padding: 10px 0;
  border-bottom: 1px solid currentColor;
}

.hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
  min-height: 100svh;
  padding: 80px 0 0;
  color: var(--ink);
  background: #ffffff;
}

.heroMedia {
  position: relative;
  grid-column: 2;
  grid-row: 1;
  min-height: calc(100svh - 80px);
  overflow: hidden;
  background: #ffffff;
}

.heroImage,
.heroVideo,
.heroShade {
  position: absolute;
  inset: 0;
}

.heroImage,
.heroVideo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.heroVideo {
  transform: scale(1.015);
}

.heroShade {
  display: none;
}

.heroContent {
  grid-column: 1;
  grid-row: 1;
  align-self: end;
  width: min(670px, 100%);
  padding: 0 clamp(32px, 8vw, 132px) 190px;
}

.eyebrow,
.eyebrowDark {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.hero h1,
.sectionIntro h2,
.relax h2,
.reviewHeading h2,
.eventsTop h2 {
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(54px, 7vw, 116px);
  font-weight: 400;
  letter-spacing: -0.07em;
  line-height: 0.9;
  text-wrap: balance;
}

.hero h1 em {
  font-style: italic;
  font-weight: 400;
}

.heroText {
  max-width: 510px;
  margin: 28px 0 0;
  color: var(--muted);
  font-size: 16px;
  letter-spacing: -0.018em;
  line-height: 1.64;
}

.heroLinks {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 23px;
  align-items: center;
  margin-top: 34px;
}

.primaryLink,
.secondaryLink,
.darkLink,
.footerBook,
.bookingPromptLink {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  color: var(--ink);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-decoration: none;
  text-transform: uppercase;
}

.primaryLink {
  padding: 0 18px;
  border: 1px solid var(--ink);
  background: #ffffff;
}

.secondaryLink,
.darkLink,
.footerBook,
.bookingPromptLink {
  padding-bottom: 8px;
  border-bottom: 1px solid currentColor;
}

.arrow {
  display: inline-block;
  font-size: 16px;
  font-weight: 400;
  line-height: 1;
  transition: transform 180ms ease;
}

.primaryLink:hover .arrow,
.secondaryLink:hover .arrow,
.darkLink:hover .arrow,
.footerBook:hover .arrow,
.bookingPromptLink:hover .arrow,
.googleLink:hover .arrow,
.reviewMeta a:hover .arrow {
  transform: translate(2px, -2px);
}

.heroFacts {
  position: absolute;
  bottom: 40px;
  left: clamp(32px, 8vw, 132px);
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(105px, 1fr));
  width: min(570px, calc(50% - 64px));
  margin: 0;
  border-top: 1px solid var(--line);
}

.heroFacts div {
  padding: 14px 14px 0 0;
}

.heroFacts div + div {
  padding-left: 15px;
  border-left: 1px solid var(--line);
}

.heroFacts dt {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.heroFacts dd {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.12em;
  line-height: 1.35;
  text-transform: uppercase;
}

.overview,
.homes,
.relax,
.reviews,
.events,
.footer {
  background: #ffffff;
}

.overview {
  padding: 132px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.overviewGrid {
  display: grid;
  grid-template-columns: 0.42fr 1.12fr 0.72fr;
  gap: 34px;
  align-items: start;
}

.overviewGrid h2 {
  max-width: 700px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(42px, 5vw, 78px);
  font-weight: 400;
  letter-spacing: -0.065em;
  line-height: 0.95;
}

.overviewRight p,
.eventsTop > p,
.bookingPrompt > div:last-child > p {
  max-width: 420px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.63;
}

.overviewRight ul {
  display: grid;
  gap: 11px;
  margin: 34px 0 0;
  padding: 0;
  list-style: none;
}

.overviewRight li {
  padding-top: 11px;
  border-top: 1px solid var(--line);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.homes,
.reviews,
.events {
  padding: 132px 0;
  scroll-margin-top: 100px;
}

.sectionIntro {
  display: grid;
  grid-template-columns: 0.42fr 1.12fr;
  gap: 34px;
  align-items: start;
  margin-bottom: 68px;
}

.sectionIntro .eyebrowDark {
  margin-top: 8px;
}

.homesGrid,
.eventsGrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(350px, 0.83fr);
  gap: clamp(44px, 8vw, 126px);
  align-items: start;
}

.imageFrameTall,
.imageFrameEvent {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  background: #ffffff;
}

.imageFrameTall {
  min-height: 720px;
}

.imageFrameEvent {
  min-height: 610px;
}

.cover {
  object-fit: cover;
}

.homeDetails {
  padding-top: 4px;
}

.sectionText {
  max-width: 530px;
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  letter-spacing: -0.018em;
  line-height: 1.65;
}

.specList {
  display: grid;
  margin: 43px 0 0;
  border-top: 1px solid var(--line);
}

.specList div {
  display: grid;
  grid-template-columns: 0.36fr 0.64fr;
  gap: 22px;
  padding: 17px 0;
  border-bottom: 1px solid var(--line);
}

.specList dt,
.amenities > p {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.specList dd {
  margin: 0;
  font-size: 14px;
  line-height: 1.4;
}

.amenities {
  margin-top: 38px;
}

.amenities > p {
  margin: 0 0 16px;
}

.amenities ul {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 11px 18px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.amenities li,
.rules li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.amenities li {
  font-size: 13px;
  line-height: 1.35;
}

.amenities li::before,
.rules li::before {
  width: 4px;
  height: 4px;
  flex: 0 0 auto;
  margin-top: 6px;
  content: "";
  background: var(--ink);
  border-radius: 50%;
}

.rules {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  margin: 36px 0 38px;
  padding: 0;
  color: var(--muted);
  list-style: none;
}

.rules li {
  font-size: 11px;
  line-height: 1.4;
}

.relax {
  padding: 0 0 132px;
  scroll-margin-top: 100px;
}

.relaxMedia {
  position: relative;
  width: min(1320px, calc(100% - 64px));
  height: min(57vw, 690px);
  min-height: 470px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid var(--line);
}

.relaxShade {
  display: none;
}

.relax .container {
  margin-top: 92px;
}

.relaxGrid {
  display: grid;
  grid-template-columns: 0.92fr 0.72fr;
  gap: clamp(52px, 12vw, 190px);
  align-items: end;
}

.relaxText {
  max-width: 520px;
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.65;
}

.relaxFacts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 26px;
  margin: 48px 0 0;
  border-top: 1px solid var(--line);
}

.relaxFacts div {
  padding: 17px 0;
  border-bottom: 1px solid var(--line);
}

.relaxFacts dt {
  font-size: 13px;
  font-weight: 500;
}

.relaxFacts dd {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 0.13em;
  line-height: 1.4;
  text-transform: uppercase;
}

.reviews {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.reviewHeading {
  display: grid;
  grid-template-columns: 1.1fr 0.6fr;
  gap: clamp(42px, 9vw, 150px);
  align-items: end;
}

.googleLink {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  width: fit-content;
  padding-bottom: 8px;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.13em;
  line-height: 1.45;
  text-decoration: none;
  text-transform: uppercase;
}

.reviewMeta {
  display: grid;
  grid-template-columns: 0.85fr 0.75fr auto;
  gap: 30px;
  align-items: end;
  margin-top: 72px;
  padding: 27px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.reviewMeta p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.13em;
  line-height: 1.45;
  text-transform: uppercase;
}

.reviewMeta div > p {
  margin-bottom: 10px;
}

.reviewMeta strong {
  display: block;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(45px, 5vw, 74px);
  font-weight: 400;
  letter-spacing: -0.07em;
  line-height: 0.85;
}

.reviewMeta a {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  justify-self: end;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--ink);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-decoration: none;
  text-transform: uppercase;
}

.reviewQuotes {
  display: grid;
  margin-top: 15px;
  border-top: 1px solid var(--line);
}

.reviewQuotes blockquote {
  display: grid;
  grid-template-columns: 52px 1fr auto;
  gap: 20px;
  align-items: end;
  margin: 0;
  padding: 27px 0;
  border-bottom: 1px solid var(--line);
}

.reviewQuotes span,
.reviewQuotes cite {
  color: var(--muted);
  font-size: 10px;
  font-style: normal;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.reviewQuotes p {
  max-width: 730px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(28px, 3.3vw, 50px);
  font-weight: 400;
  letter-spacing: -0.055em;
  line-height: 0.98;
}

.events {
  border-bottom: 1px solid var(--line);
}

.eventsTop {
  display: grid;
  grid-template-columns: 1.12fr 0.58fr;
  gap: clamp(44px, 8vw, 132px);
  align-items: end;
  margin-bottom: 67px;
}

.eventsGrid {
  align-items: stretch;
}

.eventFeatures {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--line);
}

.eventFeatures li {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 15px;
  align-items: center;
  min-height: 82px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  font-size: 15px;
  line-height: 1.35;
}

.eventFeatures span {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.11em;
}

.bookingPrompt {
  display: grid;
  grid-template-columns: 1.04fr 0.66fr;
  gap: clamp(42px, 9vw, 145px);
  align-items: end;
  margin-top: 105px;
  padding: 31px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.bookingPrompt h3 {
  max-width: 670px;
  margin: 0;
  font-family: var(--font-serif), Georgia, serif;
  font-size: clamp(36px, 4.1vw, 64px);
  font-weight: 400;
  letter-spacing: -0.06em;
  line-height: 0.95;
}

.bookingPromptLink {
  width: fit-content;
  margin-top: 29px;
}

.footer {
  padding: 64px 0 34px;
}

.footerGrid {
  display: grid;
  grid-template-columns: 1.1fr 0.72fr auto;
  gap: 46px;
  align-items: end;
}

.footerLogo {
  margin: 0;
  font-size: 19px;
  font-weight: 500;
  letter-spacing: 0.23em;
}

.footerGrid > div:first-child > p:last-child {
  max-width: 250px;
  margin: 18px 0 0;
  color: var(--muted);
  font-family: var(--font-serif), Georgia, serif;
  font-size: 20px;
  font-style: italic;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.footerGrid > div:nth-child(2) {
  display: grid;
  gap: 8px;
}

.footerGrid > div:nth-child(2) > p {
  margin: 0 0 7px;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.footerGrid > div:nth-child(2) a,
.footerGrid > div:nth-child(2) span {
  color: var(--ink);
  font-size: 13px;
  text-decoration: none;
}

@media (max-width: 980px) {
  .container,
  .relaxMedia {
    width: min(100% - 40px, 760px);
  }

  .header {
    height: 72px;
    grid-template-columns: 1fr auto;
    padding: 0 20px;
  }

  .nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 72px;
  }

  .heroMedia {
    grid-column: 1;
    grid-row: 1;
    min-height: 62svh;
  }

  .heroContent {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    padding: 68px 20px 48px;
  }

  .heroFacts {
    position: static;
    grid-column: 1;
    grid-row: 3;
    width: calc(100% - 40px);
    margin: 0 20px 54px;
  }

  .overview,
  .homes,
  .reviews,
  .events {
    padding: 92px 0;
  }

  .overviewGrid,
  .sectionIntro,
  .homesGrid,
  .relaxGrid,
  .reviewHeading,
  .eventsTop,
  .eventsGrid,
  .bookingPrompt {
    grid-template-columns: 1fr;
  }

  .overviewGrid,
  .sectionIntro,
  .eventsTop,
  .reviewHeading {
    gap: 24px;
  }

  .sectionIntro {
    margin-bottom: 44px;
  }

  .imageFrameTall {
    min-height: 560px;
  }

  .imageFrameEvent {
    min-height: 510px;
  }

  .homesGrid,
  .eventsGrid,
  .relaxGrid {
    gap: 42px;
  }

  .relax {
    padding-bottom: 92px;
  }

  .relax .container {
    margin-top: 65px;
  }

  .bookingPrompt {
    gap: 30px;
    margin-top: 74px;
  }

  .footerGrid {
    grid-template-columns: 1fr 1fr;
  }

  .footerBook {
    grid-column: 1 / -1;
    width: fit-content;
    margin-top: 14px;
  }
}

@media (max-width: 640px) {
  .headerActions {
    gap: 13px;
  }

  .logo {
    font-size: 16px;
  }

  .headerBook {
    font-size: 9px;
  }

  .heroMedia {
    min-height: 54svh;
  }

  .hero h1,
  .sectionIntro h2,
  .relax h2,
  .reviewHeading h2,
  .eventsTop h2 {
    font-size: clamp(47px, 14vw, 72px);
  }

  .heroText,
  .sectionText,
  .relaxText {
    font-size: 15px;
  }

  .heroFacts {
    grid-template-columns: 1fr 1fr;
  }

  .heroFacts div:nth-child(3) {
    grid-column: 1 / -1;
    margin-top: 13px;
    padding-left: 0;
    border-left: 0;
  }

  .overviewGrid h2 {
    font-size: clamp(40px, 12vw, 58px);
  }

  .specList div {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .amenities ul,
  .relaxFacts {
    grid-template-columns: 1fr;
  }

  .imageFrameTall {
    min-height: 440px;
  }

  .imageFrameEvent {
    min-height: 390px;
  }

  .reviewMeta {
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 50px;
  }

  .reviewMeta a {
    justify-self: start;
  }

  .reviewQuotes blockquote {
    grid-template-columns: 32px 1fr;
    gap: 14px;
  }

  .reviewQuotes cite {
    grid-column: 2;
  }

  .eventsTop {
    margin-bottom: 42px;
  }

  .footer {
    padding-top: 56px;
  }

  .footerGrid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .footerBook {
    grid-column: auto;
    margin-top: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  :global(html) {
    scroll-behavior: auto;
  }

  .arrow {
    transition: none;
  }
}
