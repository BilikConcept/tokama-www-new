function Arrow() {
  return <span className={styles.arrow} aria-hidden="true">↗</span>;
}

export function TokamaHomepage({ locale }: { locale: TokamaLocale }) {
  const t = content[locale];
  const bookingHref = locale === "pl" ? "/rezerwacja" : "/en/book";
  const languageHref = locale === "pl" ? "/en" : "/";
  const languageLabel = locale === "pl" ? "EN" : "PL";

  return (
    <main className={styles.page}>
      <header className={styles.header}>
        <Link href={locale === "pl" ? "/" : "/en"} className={styles.logo} aria-label="TOKAMA">
          TOKAMA
        </Link>

        <nav className={styles.nav} aria-label="Main navigation">
          {t.nav.map((item) => (
            <a key={item.href} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>

        <div className={styles.headerActions}>
          <Link href={languageHref} className={styles.language}>
            {languageLabel}
