.page {
  color: #111;
  background: #fff;
}

.intro {
  display: grid;
  min-height: min(68svh, 720px);
  place-items: center;
  padding: 210px 24px 96px;
  background: #fff;
  text-align: center;
  box-sizing: border-box;
}

.intro > div {
  width: min(100%, 800px);
}

.intro h1,
.copy h2 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: clamp(32px, calc(28px + 1.6vw), 48px);
  font-weight: 400;
  letter-spacing: -0.04em;
  line-height: 1.08;
}

.intro h1 em,
.copy h2 em {
  font-style: italic;
}

.intro p {
  max-width: 640px;
  margin: 26px auto 0;
  font-size: clamp(15px, calc(14px + 0.25vw), 17px);
  line-height: 1.5;
}

.showcase {
  position: relative;
  display: grid;
  min-height: calc(100svh - 150px);
  overflow: hidden;
  place-items: end center;
  isolation: isolate;
  color: #fff;
  background: #111;
}

.video,
.shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.video {
  z-index: -2;
  object-fit: cover;
  opacity: 0;
  transform: scale(1.025);
  transition: opacity 800ms ease, transform 1600ms cubic-bezier(0.22, 1, 0.36, 1);
}

.videoActive {
  opacity: 1;
  transform: scale(1);
}

.shade {
  z-index: -1;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.56));
}

.tabs {
  position: absolute;
  top: 42px;
  left: 50%;
  display: flex;
  gap: 28px;
  transform: translateX(-50%);
}

.tabs button {
  position: relative;
  padding: 0 0 10px;
  border: 0;
  color: rgba(255, 255, 255, 0.72);
  background: transparent;
  font: inherit;
  font-size: 14px;
  cursor: pointer;
}

.tabs button::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  content: "";
  background: #fff;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 250ms ease;
}

.tabs .tabActive {
  color: #fff;
}

.tabs .tabActive::after {
  transform: scaleX(1);
}

.copy {
  display: grid;
  width: min(100%, 700px);
  justify-items: center;
  padding: 32px 24px 88px;
  text-align: center;
  box-sizing: border-box;
}

.copy h2 {
  color: #fff;
}

.copy p {
  max-width: 580px;
  margin: 18px 0 0;
  color: #fff;
  font-size: clamp(14px, calc(14px + 0.2vw), 16px);
  line-height: 1.4;
}

@media (max-width: 640px) {
  .intro {
    min-height: 58svh;
    padding: 150px 18px 72px;
  }

  .tabs {
    top: 28px;
    gap: 18px;
  }

  .tabs button {
    font-size: 13px;
  }

  .copy {
    padding: 32px 18px 54px;
  }
}


/* Homepage typography alignment */
.intro h1,
.copy h2 {
  max-width: 760px;
  margin: 0;
  font-family: Georgia, serif;
  font-size: clamp(28px, calc(23.38px + 1.233vw), 36px);
  font-weight: 400;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.intro p,
.copy p {
  max-width: 36rem;
  font-size: clamp(14px, calc(12.84px + 0.308vw), 16px);
  font-weight: 400;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.intro p {
  margin-top: 24px;
}

.copy p {
  margin-top: 18px;
}
/* End homepage typography alignment */


/* Relax details */
.relaxDetails {
  background: #fff;
  padding: clamp(84px, 11vw, 150px) 24px;
  box-sizing: border-box;
}

.relaxDetailsHeader {
  width: min(100%, 760px);
  margin: 0 auto;
  text-align: center;
}

.relaxDetailsHeader h2 {
  margin: 0;
  color: #111;
  font-family: Georgia, serif;
  font-size: clamp(28px, calc(23.38px + 1.233vw), 36px);
  font-weight: 400;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.relaxDetailsHeader h2 em {
  font-style: italic;
}

.relaxDetailsHeader > p {
  max-width: 36rem;
  margin: 24px auto 0;
  color: #111;
  font-size: clamp(14px, calc(12.84px + 0.308vw), 16px);
  letter-spacing: -0.01em;
  line-height: 1.35;
}

.relaxDetailsList {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  width: min(100%, 980px);
  margin: clamp(58px, 8vw, 96px) auto 0;
  border-top: 1px solid rgba(17, 17, 17, 0.22);
}

.relaxDetail {
  padding: 26px 28px 0;
  border-right: 1px solid rgba(17, 17, 17, 0.22);
}

.relaxDetail:first-child {
  padding-left: 0;
}

.relaxDetail:last-child {
  padding-right: 0;
  border-right: 0;
}

.relaxDetail h3 {
  margin: 0;
  color: #111;
  font-family: Georgia, serif;
  font-size: 23px;
  font-weight: 400;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.relaxDetail p,
.relaxDetailsNote p {
  margin: 14px 0 0;
  color: #111;
  font-size: 14px;
  letter-spacing: -0.01em;
  line-height: 1.45;
}

.relaxDetailsNote {
  width: min(100%, 980px);
  margin: 48px auto 0;
  padding-top: 20px;
  border-top: 1px solid rgba(17, 17, 17, 0.22);
}

.relaxDetailsNote p {
  margin: 0;
  color: rgba(17, 17, 17, 0.64);
}

@media (max-width: 760px) {
  .relaxDetails {
    padding-right: 18px;
    padding-left: 18px;
  }

  .relaxDetailsList {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .relaxDetail,
  .relaxDetail:first-child,
  .relaxDetail:last-child {
    padding: 24px 0 0;
    border-right: 0;
  }

  .relaxDetail:not(:first-child) {
    border-top: 1px solid rgba(17, 17, 17, 0.22);
  }
}
/* End relax details */


/* Relax intro balanced spacing */
.intro {
  min-height: 0;
  padding: clamp(130px, 11vw, 230px) 24px;
}

@media (max-width: 640px) {
  .intro {
    min-height: 0;
    padding: 112px 18px;
  }
}
/* End relax intro balanced spacing */
