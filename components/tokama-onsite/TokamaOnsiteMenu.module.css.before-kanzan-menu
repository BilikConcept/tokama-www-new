.page {
  min-height: 100svh;
  color: #111;
  background: #fff;
}

.loading {
  display: grid;
  min-height: 100svh;
  place-items: center;
  margin: 0;
  font-size: 14px;
}

.menu {
  width: min(100% - 48px, 1120px);
  margin: 0 auto;
  padding: calc(var(--tokama-header-height, 150px) + 64px) 0 100px;
}

.header {
  max-width: 680px;
  margin-bottom: clamp(62px, 8vw, 100px);
}

.kicker {
  margin: 0 0 22px;
  color: rgba(17, 17, 17, 0.54);
  font-size: 11px;
  letter-spacing: 0.16em;
}

.header h1,
.errorScreen h1,
.successScreen h1 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: clamp(34px, 5vw, 58px);
  font-weight: 400;
  line-height: 1.03;
  letter-spacing: -0.04em;
}

.header h1 em,
.errorScreen h1 em {
  font-style: italic;
}

.header > p:last-child,
.errorScreen p,
.successScreen p {
  max-width: 36rem;
  margin: 22px 0 0;
  color: rgba(17, 17, 17, 0.72);
  font-size: 16px;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
  gap: clamp(34px, 6vw, 88px);
  align-items: start;
}

.list {
  border-top: 1px solid #111;
}

.item {
  padding: 22px 0;
  border-bottom: 1px solid rgba(17, 17, 17, 0.28);
}

.itemToggle {
  display: flex;
  width: 100%;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 0;
  border: 0;
  color: #111;
  background: transparent;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.itemToggle span {
  display: grid;
  gap: 8px;
}

.itemToggle strong {
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.itemToggle small {
  max-width: 32rem;
  color: rgba(17, 17, 17, 0.65);
  font-size: 14px;
  line-height: 1.3;
}

.itemToggle b {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid #111;
  font-size: 18px;
  font-weight: 400;
}

.itemPrice {
  margin: 16px 0 0;
  font-size: 14px;
}

.itemOptions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 22px;
}

.variants {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.variants button {
  min-height: 34px;
  padding: 0 10px;
  border: 1px solid rgba(17, 17, 17, 0.34);
  color: #111;
  background: #fff;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}

.variants button.variantActive {
  color: #fff;
  border-color: #111;
  background: #111;
}

.quantity {
  display: grid;
  grid-template-columns: 36px 42px 36px;
  align-items: center;
  min-height: 36px;
  border: 1px solid #111;
}

.quantity button {
  height: 34px;
  padding: 0;
  border: 0;
  color: #111;
  background: #fff;
  font-size: 18px;
  cursor: pointer;
}

.quantity strong {
  text-align: center;
  font-size: 14px;
  font-weight: 500;
}

.summary {
  position: sticky;
  top: calc(var(--tokama-header-height, 150px) + 30px);
  padding: 24px 0;
  border-top: 1px solid #111;
  border-bottom: 1px solid #111;
}

.summary > p {
  margin: 0;
  font-size: 14px;
  font-weight: 500;
}

.summaryItems {
  display: grid;
  gap: 12px;
  margin-top: 24px;
}

.summaryItems span {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: rgba(17, 17, 17, 0.74);
  font-size: 13px;
}

.summaryItems b {
  color: #111;
  font-weight: 500;
  white-space: nowrap;
}

.summary label {
  display: grid;
  gap: 10px;
  margin-top: 24px;
}

.summary label span {
  color: rgba(17, 17, 17, 0.58);
  font-size: 12px;
}

.summary textarea {
  width: 100%;
  resize: vertical;
  padding: 0 0 10px;
  border: 0;
  border-bottom: 1px solid rgba(17, 17, 17, 0.32);
  border-radius: 0;
  color: #111;
  background: #fff;
  font: inherit;
  outline: none;
  box-sizing: border-box;
}

.total {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 26px;
  padding-top: 16px;
  border-top: 1px solid rgba(17, 17, 17, 0.24);
}

.total span {
  color: rgba(17, 17, 17, 0.62);
  font-size: 13px;
}

.total strong {
  font-family: Georgia, serif;
  font-size: 26px;
  font-weight: 400;
  letter-spacing: -0.03em;
}

.submit {
  width: 100%;
  min-height: 52px;
  margin-top: 22px;
  border: 1px solid #111;
  border-radius: 0;
  color: #fff;
  background: #111;
  font: inherit;
  font-size: 14px;
  cursor: pointer;
  transition: color 220ms ease, background 220ms ease;
}

.submit:hover:not(:disabled) {
  color: #111;
  background: #fff;
}

.submit:disabled {
  opacity: 0.55;
  cursor: wait;
}

.empty,
.emptySummary {
  display: block;
  color: rgba(17, 17, 17, 0.64);
  font-size: 14px;
}

.empty {
  padding: 24px 0;
  border-top: 1px solid #111;
  border-bottom: 1px solid rgba(17, 17, 17, 0.28);
}

.emptySummary {
  margin-top: 24px;
}

.errorScreen,
.successScreen {
  display: grid;
  min-height: 100svh;
  align-content: center;
  justify-items: center;
  padding: calc(var(--tokama-header-height, 150px) + 48px) 24px 72px;
  text-align: center;
}

.errorScreen a {
  margin-top: 30px;
  padding-bottom: 4px;
  border-bottom: 1px solid #111;
  color: #111;
  font-size: 14px;
  text-decoration: none;
}

.successScreen strong {
  color: #111;
  font-weight: 500;
}

.successNote {
  margin-top: 34px !important;
  padding-top: 18px;
  border-top: 1px solid rgba(17, 17, 17, 0.24);
}

@media (max-width: 760px) {
  .menu {
    width: min(100% - 36px, 1120px);
    padding-top: calc(var(--tokama-header-height, 132px) + 42px);
  }

  .layout {
    grid-template-columns: 1fr;
  }

  .summary {
    position: static;
  }

  .itemToggle strong {
    font-size: 17px;
  }
}
