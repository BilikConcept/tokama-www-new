/* Centered hero headline */
@media (min-width: 981px) {
  .content {
    left: 0;
    right: 0;
    width: min(940px, calc(100% - 80px));
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .description {
    margin-left: auto;
    margin-right: auto;
  }

  .ctaRow {
    justify-content: center;
  }
}

/* Smaller and more centered hero content */
@media (min-width: 981px) {
  .content {
    top: 50%;
    bottom: auto;
    left: 50%;
    right: auto;
    width: min(820px, calc(100% - 80px));
    margin: 0;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .content h1 {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
    font-size: clamp(48px, 5.9vw, 88px);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  .content h1 em {
    letter-spacing: -0.08em;
  }

  .description {
    max-width: 500px;
    margin-top: 22px;
    margin-left: auto;
    margin-right: auto;
    font-size: 16px;
    line-height: 1.58;
  }

  .ctaRow {
    justify-content: center;
    margin-top: 28px;
  }
}

@media (max-width: 980px) {
  .content h1 {
    font-size: clamp(38px, 11.5vw, 60px);
  }
}

/* Fix true center positioning — animation cannot override transform */
@media (min-width: 981px) {
  .content {
    top: 50%;
    left: 50%;
    right: auto;
    bottom: auto;
    width: min(820px, calc(100% - 80px));
    margin: 0;
    text-align: center;
    transform: translate(-50%, -50%);
    animation: contentFadeOnly 900ms ease both;
  }
}

@keyframes contentFadeOnly {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* Temporary hero image */
.fallbackImage {
  z-index: 0;
  background-image: url("/images/tokama-hero-poster.jpg");
  background-size: cover;
  background-position: center;
}

.video {
  z-index: 1;
}

.overlay {
  z-index: 2;
}

/* Transparent adaptive header */
.header {
  color: #ffffff;
  background: transparent;
  border-bottom: 0;
  backdrop-filter: none;
  mix-blend-mode: difference;
}

.headerScrolled {
  height: 84px;
  color: #ffffff;
  background: transparent;
  border-bottom: 0;
  backdrop-filter: none;
}

.headerMenuOpen {
  color: #000000;
  background: #ffffff;
  mix-blend-mode: normal;
}

.headerMenuOpen.headerScrolled {
  color: #000000;
  background: #ffffff;
  mix-blend-mode: normal;
}

.headerScrolled .bookButton:hover {
  color: #000000;
  background: #ffffff;
}

.headerMenuOpen .bookButton:hover {
  color: #ffffff;
  background: #000000;
}

/* Stable mobile header colors */
@media (max-width: 980px) {
  .header {
    color: #ffffff;
    background: transparent;
    border-bottom: 0;
    backdrop-filter: none;
    mix-blend-mode: normal;
  }

  .headerScrolled {
    color: #000000;
    background: transparent;
    border-bottom: 0;
    backdrop-filter: none;
    mix-blend-mode: normal;
  }

  .headerMenuOpen,
  .headerMenuOpen.headerScrolled {
    color: #000000;
    background: #ffffff;
    mix-blend-mode: normal;
  }
}
